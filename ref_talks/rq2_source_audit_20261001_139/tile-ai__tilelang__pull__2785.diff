+            C_tmem = T.alloc_tmem((batch_size, 128, 128), T.float32)
+            done = T.alloc_barrier(1)
+            C_local = T.alloc_fragment((batch_size, 128, 128), T.float32)
+            C_shared = T.alloc_shared((128, 128), T.bfloat16)
+
+            T.copy(A, A_shared)
+            T.copy(B, B_shared)
