+            A_shared = T.alloc_shared((128, 64), T.bfloat16)
+            B_shared = T.alloc_shared((128, 64), T.bfloat16)
+            C_tmem = T.alloc_tmem((128, 256), T.float32)
+            done = T.alloc_barrier(1)
+            T.tcgen05_gemm(
+                A_shared,
+                B_shared,
+                C_tmem,
+                transpose_B=True,
+                clear_accum=True,
+                mbar=done,
+                use_2cta=True,
+            )
+
+    return main
+
+
