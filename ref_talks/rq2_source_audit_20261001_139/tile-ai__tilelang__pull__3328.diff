+            A: T.Buffer((TILE_M, TILE_K), "float16"),
+            B: T.Buffer((TILE_N, TILE_K), "float16"),
+            C: T.Buffer(dst_shape, "float16"),
+            sizes: T.Buffer((1,), "int32"),
