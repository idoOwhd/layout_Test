+
+def InjectTextureAlloc():
+    """Inject Texture Allocation Intrinsic to make sure appropriate lowering
+    via alloc_nd/alloc_free calls
+    Returns
+    -------
+    fpass : tvm.transform.Pass
+        The result pass
+    """
