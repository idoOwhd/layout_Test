+    %red_orig = ttg.convert_layout %red : tensor<128xf32, #out_planned> -> tensor<128xf32, #out_orig>
+    tt.store %out_orig, %red_orig : tensor<128x!tt.ptr<f32>, #out_orig>
+    tt.return
+  }
+}
