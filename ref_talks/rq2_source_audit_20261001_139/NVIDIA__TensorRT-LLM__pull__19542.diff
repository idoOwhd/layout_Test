+            operand_stages * self.operand_bytes_per_stage
+        )
+        if not overlay_fc2_c:
+            mainloop_bytes = sum(
+                align_up(operand_stages * bytes_per_stage)
+                for bytes_per_stage in (
+                    self.a_per_stage,
+                    self.b_per_stage,
+                    self.sfb_per_stage,
+                )
+            )
+        return align_up(
+            header
+            + mainloop_bytes
+            + align_up(operand_stages * self.sfa_per_stage)
+            + align_up(epilogue_bytes)
+            + self.metadata
+        )
