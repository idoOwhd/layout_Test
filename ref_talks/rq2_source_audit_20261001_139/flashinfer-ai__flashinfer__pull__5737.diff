+__device__ __forceinline__ void ex2_emulation_f32x2(float* x0_ptr, float* x1_ptr) {
+    float2 result = ex2_emulation_f32x2_value(make_float2(*x0_ptr, *x1_ptr));
+    *x0_ptr = result.x; *x1_ptr = result.y;
+}
