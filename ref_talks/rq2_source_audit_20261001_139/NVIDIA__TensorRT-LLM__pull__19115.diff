+            output_buf.data_ptr(),
+            cutlass.AddressSpace.gmem,
+            assumed_align=16,
+        )
+        sf_c_dp = make_ptr(
+            sf_dtype,
+            output_scale.data_ptr(),
+            cutlass.AddressSpace.gmem,
+            assumed_align=16,
+        )
+    else:
+        c0_dp = make_ptr(
+            cutlass.BFloat16,
+            output_buf.data_ptr(),
+            cutlass.AddressSpace.gmem,
