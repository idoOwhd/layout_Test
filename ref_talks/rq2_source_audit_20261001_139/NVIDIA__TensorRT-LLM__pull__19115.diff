+    if "num_stages_workid" in options:
+        kwargs["num_stages_workid"] = int(options["num_stages_workid"])
+    if "num_stages_c_smem" in options:
+        kwargs["num_stages_c_smem"] = int(options["num_stages_c_smem"])
