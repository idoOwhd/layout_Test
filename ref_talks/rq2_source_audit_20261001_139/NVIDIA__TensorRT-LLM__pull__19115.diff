+    _alloc_dsfp8_absmax: Constexpr[Optional[SmemAllocation]] = None
+    _alloc_bias: Constexpr[Optional[SmemAllocation]] = None
+    _alloc_per_token_sf_a: Constexpr[Optional[SmemAllocation]] = None
