+            dtype=sc_dtype,
+            shape=(self._alloc_sc.size_bytes // sc_elem_bytes,),
+            addrspace=3,
+        )
+        self.sCFloat = cutlass.Array(
+            context.smem_base.data_ptr() + self._alloc_sc.offset,
