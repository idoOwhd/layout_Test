+                            else:
+                                if output_in_bounds:
+                                    self.gC.store(
+                                        val_out,
+                                        idx=flat_idx,
+                                        vector_size=1,
+                                        alignment=(
+                                            1 if self.cfg.uses_fp8_output else 2
+                                        ),
