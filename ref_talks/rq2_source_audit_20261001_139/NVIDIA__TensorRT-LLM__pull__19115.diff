+        self.sfb_tmem_addr_base = (base_row << 16) | sfb_col
+
+    @producer_work(work_attrs=WorkAttr.AUXILIARY)
+    @cute.jit
+    def init_copy_state(self, stage_info: StageInfo) -> None:
+        self._init_tmem_state(stage_info)
