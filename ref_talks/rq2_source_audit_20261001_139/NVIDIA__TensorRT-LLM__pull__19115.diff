+@pytest.mark.skipif(get_sm_version() not in (100, 103, 107), reason="requires Blackwell or Rubin")
+@pytest.mark.parametrize("nvfp4,tactic", [(False, (64, 0)), (True, (8, 18)), (True, (16, 12))])
