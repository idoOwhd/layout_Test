+def _activation_act_kind(activation_type: int) -> int:
+    act_kind = _ACTIVATION_TO_ACT_KIND.get(int(activation_type))
+    if act_kind is None:
+        raise ValueError(f"Unsupported Prims-TS activation_type={activation_type!r}")
+    return act_kind
