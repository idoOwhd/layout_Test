+            if cutlass.const_expr(self.cfg.use_tma_store):
+                self._commit_swap_ab_bf16_tma(
+                    tile_coord_m,
+                    tile_coord_n,
+                    n_subtile_offset,
+                    token_limit,
+                    warp_idx,
+                    warpgroup_idx,
