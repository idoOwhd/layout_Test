+                context.smem_base.data_ptr() + self._alloc_bias.offset,
+                dtype=cutlass.Float32,
+                shape=(self.cfg.tile_m,),
+                addrspace=3,
+            )
+        if cutlass.const_expr(self._alloc_per_token_sf_a is not None):
