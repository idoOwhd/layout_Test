+        Call once per scale_slot BEFORE the batched bar.sync.
+        """
+        warp_absmax = self._reduce_fp4_absmax_m16(val)
+        smem_idx = self._absmax_scratch_idx(
+            warpgroup_idx, warp_in_epi4, lane_id, scale_slot
