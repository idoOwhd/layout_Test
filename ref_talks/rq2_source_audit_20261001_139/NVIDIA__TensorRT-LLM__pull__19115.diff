+        with _work_tile_schedule_loop(cfg, wq):
+            _ = gmem_b_res.compute_b_coords_head()
+            _ = gmem_sfb_res.init_tile_state()
+            _call_named_aux_if_present(
+                smem_b_res, "prepare_gather_tile", has_prepare_gather_tile
