+    gBias: Any = None
+    gScaleC: Any = None
+    gScaleGate: Any = None
+    gGemm1Alpha: Any = None
+    gGemm1Beta: Any = None
+    gGemm1ClampLimit: Any = None
+    gTokenFinalScales: Any = None
+    gFinalOutput: Any = None
+    gPerTokenSfA: Any = None
