+        gemm1_beta_value,
+        default=1.0 if cfg.act_kind == int(ActKind.SITU) else 0.0,
+        num_experts=L,
+        device=device,
+    )
+    gemm1_clamp_limit_torch = _make_per_expert_f32_tensor(
