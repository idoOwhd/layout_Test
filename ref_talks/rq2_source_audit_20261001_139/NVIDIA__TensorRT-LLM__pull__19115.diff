+        "load_sf_regs": load_sf_regs,
+        "load_a_regs": load_a_regs,
+        "load_b_regs": load_b_regs,
+        "load_sfa_regs": load_sfa_regs,
+        "load_sfb_regs": load_sfb_regs,
