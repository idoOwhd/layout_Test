+        "per_token_sf_a_dp": per_token_sf_a_dp,
+        "per_token_sf_b_dp": per_token_sf_b_dp,
+        "bias_dp": bias_dp,
+        "scale_c_dp": scale_c_dp,
+        "scale_gate_dp": scale_gate_dp,
+        "gemm1_alpha_dp": gemm1_alpha_dp,
+        "gemm1_beta_dp": gemm1_beta_dp,
