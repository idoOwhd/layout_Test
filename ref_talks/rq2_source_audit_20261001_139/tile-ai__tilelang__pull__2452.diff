+    if k_major:
+        # Canonical ((8,m),(2,k)):((8,SBO),(1,2)). stride<0,0>==W; stride<1,0> is
+        # the INTERLEAVE pass-through or 1 when swizzled. SBO=stride<0,1>, LBO=1.
+        assert s00 == W, f"Not a canonical UMMA_K layout: stride<0,0>={s00} != W={W}"
