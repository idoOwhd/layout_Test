+        %copy = ttg.local_alloc : () -> !ttg.memdesc<2x1xf32, #synthetic, #smem, mutable>
+        %view = ttg.memdesc_index %copy[%index] : !ttg.memdesc<2x1xf32, #synthetic, #smem, mutable> -> !ttg.memdesc<1xf32, #synthetic, #smem, mutable>
