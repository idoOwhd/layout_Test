+    %value = ttg.local_load %view : !ttg.memdesc<64xf32, #indexed, #smem, mutable, 8x64> -> tensor<64xf32, #row>
+    %offsets = tt.make_range {start = 0 : i32, end = 64 : i32} : tensor<64xi32, #row>
