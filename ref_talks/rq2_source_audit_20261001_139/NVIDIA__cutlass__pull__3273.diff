+def test_sm120_mxf4nvf4_config_and_extent_validation():
+    assert sm120.MXF4NVF4_CTA_SHAPE_MNK == (128, 128, 128)
+    assert sm120.MXF4NVF4_MMA_SHAPE_MNK == (16, 8, 64)
+    assert sm120.MXF4NVF4_SCALE_VEC_SIZE == 16
