-
-    dist = cfg["dist"]
-    mean, std, full_range = cfg["mean"], cfg["std"], cfg["full_range"]
-    low = mean - full_range / 2
-    high = mean + full_range / 2
-
-    if dist == "beta":
-        alpha, beta_p = _fit_beta_params(mean, std, low, high)
