-    # launchHeuristicTopKDecode for both fp32 (float4 = 4 elements) and
-    # bf16/fp16 (int4 = 16 B = 8 elements) in multi-row mode (matches TRT-LLM
-    # runtime where strides are always multiples of tokens_per_block >= 64).
-    max_len = (max_len + 7) & ~7
