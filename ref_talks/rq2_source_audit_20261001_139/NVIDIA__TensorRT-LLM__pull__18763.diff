-# ---------------------------------------------------------------------------
-# pre_idx generator: heuristic candidate indices for the indexer kernel
-# ---------------------------------------------------------------------------
-
-
-def generate_pre_idx(
-    logits: torch.Tensor,
-    row_ends: torch.Tensor,
-    batch_size: int,
-    next_n: int,
-    index_topk: int,
-    success_ratio: float = 0.6,
-    seed: int = 0,
