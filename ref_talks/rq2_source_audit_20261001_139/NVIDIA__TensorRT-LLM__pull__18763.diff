+def test_default_workspace_is_locality_domain_scoped(monkeypatch):
+    """Concurrent locality streams receive distinct, domain-local slabs."""
+    allocations = []
+    pool_entries = []
+    device_contexts = []
+
+    class FakeBuffer:
+        def __init__(self, allocation_id):
