+        return mod.mod.imports[0].inspect_source()
+
+    nc_src = _src(_nc_strided_reg_copy)
+    plain_src = _src(_plain_strided_reg_copy)
+
+    # cache="nc" -> vectorized 128b ld.global.nc; no cache -> plain 128b ld.
