+# R[4 : 32@TLane] — t.shape[lane] = 32 with replica 4 → 128 physical lanes.
+T_LAY_BASIC = TileLayout(S[(32, 16) : (1 @ TLane, 1 @ TCol)] + R[4 : 32 @ TLane])
