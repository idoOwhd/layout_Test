+
+Pass LowerIket() {
+  auto pass_func = [](IRModule module, tvm::transform::PassContext) {
+    return LowerIketImpl(std::move(module));
+  };
+  return tvm::transform::CreateModulePass(pass_func, 0, "tirx.backend.cuda.LowerIket", {});
+}
