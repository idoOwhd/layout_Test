+    if not context.is_instrumented():
+        raise RuntimeError("CUTLASS DSL oracle CUBIN is not IKET-instrumented")
+
+    normalized_metadata = _normalized_metadata(context)
+    manifest = {
+        "schema_version": 2,
+        "profile": {
+            "cutlass_dsl": metadata.version("nvidia-cutlass-dsl"),
