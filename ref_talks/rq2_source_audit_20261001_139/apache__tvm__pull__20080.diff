+def _cuda_source(executable):
+    modules = executable.mod._collect_from_import_tree(  # pylint: disable=protected-access
+        lambda module: module.kind == "cuda"
+    )
+    assert len(modules) == 1
+    return modules[0].inspect_source("cuda")
