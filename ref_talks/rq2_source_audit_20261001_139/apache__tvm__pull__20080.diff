+def _run_3d_4tile(s_full, t_full, s_full_shape, dtype, A_init, expected):
+    kernel = _make_3d_4tile_kernel(s_full, t_full, s_full_shape, s_full_shape, dtype)
+    return _execute(kernel, A_init, expected)
