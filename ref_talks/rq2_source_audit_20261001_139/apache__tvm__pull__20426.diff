+                                        score_a[tx, ty] = s_acc[0]
+                                    else:
+                                        score_b[tx, ty] = s_acc[0]
+                                    T.tvm_storage_sync("shared")
+                                    s_acc[0] = 0.0
+                                    for lane_i in T.unroll(lanes_per_shard):
+                                        if half == 0:
+                                            s_acc[0] += score_a[tx, lane_i]
+                                        else:
