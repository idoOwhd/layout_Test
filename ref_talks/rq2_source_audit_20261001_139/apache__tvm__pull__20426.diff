+                                        st_m[0] = T.max(st_m[0], s_acc[0])
+                                        exp_mprev[0] = T.exp2(m_prev[0] - st_m[0])
+                                        exp_otherm[0] = T.exp2(s_acc[0] - st_m[0])
+                                        st_d[0] = st_d[0] * exp_mprev[0] + exp_otherm[0]
