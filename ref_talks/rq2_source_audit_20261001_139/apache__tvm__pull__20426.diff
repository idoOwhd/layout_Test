+                                        else:
+                                            for lane in T.serial(vec_per_lane):
+                                                for vec in T.vectorized(VEC_SIZE):
+                                                    QK_local[vec] += Q_local[lane * VEC_SIZE + vec] * T.cast(pages[page_no, 0, by, page_offset, ty * dims_per_lane + lane * VEC_SIZE + vec], "float32")
