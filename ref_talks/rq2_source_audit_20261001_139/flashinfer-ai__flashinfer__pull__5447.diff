+def test_dsv4_async_config_pipeline_contract() -> None:
+    """Pin the DSV4 async/resource values derived by the TS config."""
+
+    cfg = make_mla_decode_config(
+        mma_qk_tiler_mn=(128, 128),
+        mma_pv_tiler_mn=(128, 256),
