+            rfx.seq_lens_kv,
+            rfx.cu_seqlens_q,
+            rfx.cos_sin[: int(rfx.seq_lens_kv.max()) - 1].contiguous(),
+            max_seq_len_q=rfx.max_seq_len_q,
