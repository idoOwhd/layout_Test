+        seq_lens=fx.seq_lens_kv,
+        cum_seq_lens_q=fx.cu_seqlens_q,
+        max_seq_len_q=fx.max_seq_len_q,
+    )
+    kwargs.update(overrides)
+    return prims_ts_dsv4_sparse_mla(**kwargs)
