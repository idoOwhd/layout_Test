+struct ReducerCostFeatures {
+  int64_t local_issues{0};
+  int64_t shared_issues{0};
+  int64_t shuffle_issues{0};
+  int64_t shared_rounds{0};
+  int64_t barriers{0};
+  int64_t combine_issues{0};
+  int64_t slots{0};
+  std::vector<int> vector_widths;
+};
